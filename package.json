{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:all": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@heroicons/react": "^2.2.0",
    "@mistralai/mistralai": "^1.3.0",
    "@netlify/functions": "^2.0.0",
    "@stripe/stripe-js": "^4.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^12.0.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.546.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "openai": "^4.77.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.7.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "stripe": "^14.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.axiomai.app",
    "productName": "Axiom AI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/Logo.png"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "public/Logo.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "zip"
      ],
      "artifactName": "Axiom-AI-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "public/Logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "artifactName": "Axiom-AI-Setup-${version}.${ext}",
      "publisherName": "Axiom AI"
    },
    "dmg": {
      "title": "Axiom AI Installer",
      "background": "public/dmg-background.png",
      "icon": "public/Logo.png",
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 240,
          "type": "file"
        },
        {
          "x": 380,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axiom AI",
      "installerIcon": "public/Logo.png",
      "uninstallerIcon": "public/Logo.png",
      "license": "LICENSE"
    },
    "linux": {
      "icon": "public/Logo.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Axiom AI"
    }
  }
}
